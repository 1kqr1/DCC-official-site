{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "dcc-portfolio-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/user/Desktop/dcc-portfolio && npx wrangler dev --port 8787"
      ],
      "port": 8787
    },
    {
      "name": "dcc-portal-proxy-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/user/Desktop/dcc-portal-proxy && npx wrangler pages dev public --port 8788"
      ],
      "port": 8788
    },
    {
      "name": "hp-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "portal-dev-with-local-hp",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/user/Documents/DCC/dcc-portfolio && npx wrangler dev --port 8787 --var HP_ORIGIN:http://localhost:4173 --var PUBLIC_ORIGIN:http://localhost:8787"
      ],
      "port": 8787
    }
  ]
}
